# ========================================================
# SERVER & APP CONFIGURATION
# ========================================================
PORT=5000
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRE=30d

# ========================================================
# DATABASE CONFIGURATION (MongoDB Atlas or Local MongoDB)
# ========================================================
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/mediai?retryWrites=true&w=majority

# ========================================================
# AI DIAGNOSTIC ENGINES (Gemini & Groq)
# ========================================================
# Set AI_MODEL to 'gemini-3.5-flash-lite' for Google Gemini
# or 'llama-3.3-70b-versatile' for Groq
AI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ========================================================
# CLOUDINARY (Medical Document & Avatar Storage)
# ========================================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ========================================================
# EMAIL CONFIGURATION (Google OAuth2 via Nodemailer)
# ========================================================
GOOGLE_OAUTH_EMAIL=your_email@gmail.com
EMAIL_FROM_NAME=MediAI
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_OAUTH_REFRESH_TOKEN=your_oauth_refresh_token
